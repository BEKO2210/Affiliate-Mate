# Affiliate-Mate core analysis, mock catalog, CSV intelligence, and replay require no API keys.
# Live Amazon and YouTube adapters read credentials from the environment only.
# Never commit real values.
#
# Amazon Creators API:
# AMAZON_CREATORS_CREDENTIAL_ID=
# AMAZON_CREATORS_CREDENTIAL_SECRET=
# AMAZON_CREATORS_CREDENTIAL_VERSION=3.2  # EU; use the version Amazon issued to you
# AMAZON_ASSOCIATE_TAG=
#
# YouTube Data API v3:
# YOUTUBE_API_KEY=
#
# Future production adapters:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
