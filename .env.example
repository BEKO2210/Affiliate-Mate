# Affiliate-Mate core analysis and mock catalog do not require API credentials.
# Live Amazon catalog search uses Creators API credentials from the environment.
# Never commit real values.
#
# AMAZON_CREATORS_CREDENTIAL_ID=
# AMAZON_CREATORS_CREDENTIAL_SECRET=
# AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
# AMAZON_ASSOCIATE_TAG=
#
# Future adapters:
# YOUTUBE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
